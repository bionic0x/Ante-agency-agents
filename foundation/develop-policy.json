{
  "schema_version": 1,
  "purpose": "Limits and extra protected paths of the ante develop loop. This file protects itself: a proposal that touches it is refused, and the gate reads it from the base revision.",
  "max_open_proposals": 1,
  "campaign_spend_usd": 50,
  "consecutive_regressions_to_stop": 2,
  "editable_scopes": [
    "academic/**",
    "design/**",
    "engineering/**",
    "finance/**",
    "game-development/**",
    "gis/**",
    "healthcare/**",
    "marketing/**",
    "mispriced-cmo/**",
    "paid-media/**",
    "product/**",
    "project-management/**",
    "research/**",
    "sales/**",
    "security/**",
    "spatial-computing/**",
    "specialized/**",
    "support/**",
    "testing/**",
    "strategy/vectors.json",
    "strategy/runbooks/**",
    "strategy/playbooks/**",
    "ante/nexus/**",
    "ante/registry/**",
    "ante/strategy/commands/*.py"
  ],
  "protected": [
    "foundation/develop-policy.json",
    "foundation/DECISIONS.md",
    "ante/develop/**",
    "ante/turing/**",
    "ante/ice/**",
    "ante/constructs/**",
    "ante/core/**",
    "ante/doctrine/**",
    "ante/learn/**",
    "ante/_compat.py",
    "ante/paths.py",
    "ante/strategy/artifact.py",
    "ante/strategy/base.py",
    "ante/strategy/claims.py",
    "ante/strategy/commands/cohere.py",
    "ante/strategy/commands/decide.py",
    "ante/strategy/commands/pathology.py",
    "ante/strategy/commands/selftest.py",
    "tests/**",
    "strategy/*.md",
    "strategy/challenger-pairs.json",
    "strategy/contracts.json",
    "strategy/overdrive-protected.json",
    "strategy/providers.json",
    "strategy/runbooks.json",
    "strategy/unified-agency-sources.json",
    "scripts/**",
    ".github/**"
  ]
}
